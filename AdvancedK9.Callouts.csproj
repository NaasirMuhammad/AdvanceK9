<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AdvancedK9.Callouts</AssemblyName>
    <RootNamespace>AdvancedK9.Callouts</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Callouts/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="AdvancedK9.API.csproj" Private="false" />
    <ProjectReference Include="Bridge/LspdfrApiShim/LspdfrApiShim.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="RagePluginHook" Version="1.124.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
